{
  "$defs": {
    "Referral": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "legal_aid",
            "regional",
            "emergency",
            "attorney_review"
          ],
          "title": "Kind",
          "type": "string"
        },
        "organisation": {
          "title": "Organisation",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "attempted_on": {
          "format": "date",
          "title": "Attempted On",
          "type": "string"
        },
        "status": {
          "default": "UNVERIFIED",
          "enum": [
            "UNVERIFIED",
            "VERIFIED"
          ],
          "title": "Status",
          "type": "string"
        },
        "blocker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocker"
        },
        "verified_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified On"
        },
        "review_due": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Due"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "verification_method": {
          "anyOf": [
            {
              "const": "primary_source_inspection",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Method"
        },
        "service_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Description"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "phone": {
          "anyOf": [
            {
              "pattern": "^\\+?[0-9][0-9 ()-]{1,28}[0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "additional_phones": {
          "default": [],
          "items": {
            "pattern": "^\\+?[0-9][0-9 ()-]{1,28}[0-9]$",
            "type": "string"
          },
          "title": "Additional Phones",
          "type": "array"
        },
        "hours": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hours"
        },
        "channel": {
          "anyOf": [
            {
              "enum": [
                "general_office",
                "regional_counter",
                "emergency_response",
                "complaints",
                "specialist_support",
                "mental_health_support"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "urgent_categories": {
          "default": [],
          "items": {
            "enum": [
              "domestic_violence",
              "child_protection",
              "sexual_violence",
              "unlawful_detention",
              "imminent_destitution",
              "self_harm"
            ],
            "type": "string"
          },
          "title": "Urgent Categories",
          "type": "array"
        },
        "cautions": {
          "default": [],
          "items": {
            "enum": [
              "published_listing_only",
              "availability_not_call_tested",
              "regional_phone_withheld",
              "general_office_only",
              "no_review_commitment",
              "complaints_not_emergency_response",
              "directory_text_has_repetition"
            ],
            "type": "string"
          },
          "title": "Cautions",
          "type": "array"
        },
        "directory_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Directory Url"
        },
        "directory_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Directory Sha256"
        }
      },
      "required": [
        "id",
        "kind",
        "organisation",
        "source_url",
        "attempted_on"
      ],
      "title": "Referral",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2",
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/Referral"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    }
  },
  "required": [
    "revision",
    "records"
  ],
  "title": "ReferralRegister",
  "type": "object"
}
