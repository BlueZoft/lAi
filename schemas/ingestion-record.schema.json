{
  "$defs": {
    "Extraction": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "plain_text",
            "native_pdf",
            "ocr"
          ],
          "title": "Method",
          "type": "string"
        },
        "tool": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "fonts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Fonts",
          "type": "array"
        }
      },
      "required": [
        "method",
        "tool",
        "version"
      ],
      "title": "Extraction",
      "type": "object"
    },
    "Instrument": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "act",
            "ordinance",
            "regulation",
            "bill",
            "gazette",
            "judgment"
          ],
          "title": "Kind",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 2200,
              "minimum": 1700,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "synthetic": {
          "default": false,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Instrument",
      "type": "object"
    },
    "ParseResult": {
      "additionalProperties": false,
      "properties": {
        "parser_version": {
          "const": "act-sections-v1",
          "default": "act-sections-v1",
          "title": "Parser Version",
          "type": "string"
        },
        "sections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array"
        },
        "issues": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "title": "ParseResult",
      "type": "object"
    },
    "QualityReport": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "const": "quality-v1",
          "default": "quality-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "character_count": {
          "minimum": 0,
          "title": "Character Count",
          "type": "integer"
        },
        "alphabetic_ratio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Alphabetic Ratio",
          "type": "number"
        },
        "declared_script_ratio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Declared Script Ratio",
          "type": "number"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "score",
        "character_count",
        "alphabetic_ratio",
        "declared_script_ratio",
        "issues"
      ],
      "title": "QualityReport",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "pattern": "^[1-9][0-9]{0,3}[A-Z]{0,2}$",
          "title": "Number",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Sha256",
          "type": "string"
        }
      },
      "required": [
        "number",
        "start",
        "end",
        "text",
        "text_sha256"
      ],
      "title": "Section",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "format": "uri",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "canonical_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "uri",
          "title": "Canonical Url"
        },
        "publisher": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "role": {
          "enum": [
            "official",
            "mirror",
            "manual"
          ],
          "title": "Role",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "licence": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Licence",
          "type": "string"
        },
        "metadata_reviewed": {
          "default": false,
          "title": "Metadata Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "url",
        "publisher",
        "role",
        "fetched_at",
        "revision",
        "licence"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceManifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "instrument": {
          "$ref": "#/$defs/Instrument"
        },
        "language": {
          "enum": [
            "en",
            "si",
            "ta"
          ],
          "title": "Language",
          "type": "string"
        },
        "expected_raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Raw Sha256",
          "type": "string"
        },
        "expected_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Text Sha256",
          "type": "string"
        },
        "extraction": {
          "$ref": "#/$defs/Extraction"
        },
        "acquisition": {
          "default": "upstream",
          "enum": [
            "upstream",
            "manual_seed",
            "synthetic"
          ],
          "title": "Acquisition",
          "type": "string"
        },
        "gap_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Gap Ids",
          "type": "array"
        }
      },
      "required": [
        "source",
        "instrument",
        "language",
        "expected_raw_sha256",
        "expected_text_sha256",
        "extraction"
      ],
      "title": "SourceManifest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "record_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Id",
      "type": "string"
    },
    "manifest": {
      "$ref": "#/$defs/SourceManifest"
    },
    "quality": {
      "$ref": "#/$defs/QualityReport"
    },
    "parsed": {
      "$ref": "#/$defs/ParseResult"
    }
  },
  "required": [
    "record_id",
    "manifest",
    "quality",
    "parsed"
  ],
  "title": "IngestionRecord",
  "type": "object"
}
